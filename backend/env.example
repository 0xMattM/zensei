# Zensei Multi-Agent System Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# AI API Keys (Required)
# ==============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here

# ==============================================
# SEI Blockchain Configuration (Required)
# ==============================================
SEI_PRIVATE_KEY=your-sei-private-key-here
SEI_NETWORK=testnet
RPC_URL=https://evm-rpc.sei-apis.com
EVM_CHAINS=sei

# ==============================================
# Service Ports (Optional - defaults provided)
# ==============================================
ELIZA_PORT=3010
CAMBRIAN_AGENT_PORT=3004
MCP_SERVER_PORT=3333

# ==============================================
# Eliza Configuration (Optional)
# ==============================================
NODE_ENV=production
ELIZA_UI_ENABLE=true
ELIZA_SERVER_AUTH_TOKEN=
# ELIZA_SERVER_AUTH_TOKEN=your-auth-token-here  # Optional: Enable API authentication
EXPRESS_MAX_PAYLOAD=50mb
ELIZA_NONINTERACTIVE=false
IGNORE_BOOTSTRAP=false
REMOTE_CHARACTER_URLS=

# ==============================================
# External Service APIs (Optional)
# ==============================================
BIRDEYE_API_KEY=your-birdeye-api-key-here
DISCORD_APPLICATION_ID=your-discord-app-id-here
DISCORD_API_TOKEN=your-discord-bot-token-here

# ==============================================
# Ollama Configuration (Optional)
# ==============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_SMALL_MODEL=llama3.2:1b
OLLAMA_MEDIUM_MODEL=llama3.2:3b
OLLAMA_LARGE_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_MODEL=llama3.2:3b

# ==============================================
# Cloudflared Tunnel (Optional - for web access)
# ==============================================
# Get this token from Cloudflare Zero Trust dashboard
CLOUDFLARED_TOKEN=your-cloudflared-tunnel-token-here

# ==============================================
# Logging and Debug (Optional)
# ==============================================
LOG_LEVEL=info
DEBUG=false
ENVIRONMENT=development 