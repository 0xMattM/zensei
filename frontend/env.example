# ZenSei Frontend Environment Variables
# Copy this to .env.local and fill in your values

# Required - n8n Webhook for AI Agent Communication
WEBHOOK_URL=https://your-n8n-webhook-url.com

# Required - Privy Wallet Connection
NEXT_PUBLIC_PRIVY_APP_ID=clxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PRIVY_APP_SECRET=secret-key

# Required - Agent Wallet Address (hardcoded for demo)
NEXT_PUBLIC_AGENT_ADDRESS=0x1234567890123456789012345678901234567890

# Optional - Portfolio Features (Phase 2)
NEXT_PUBLIC_COINGECKO_API=https://api.coingecko.com/api/v3
NEXT_PUBLIC_DEFILLAMA_API=https://api.llama.fi

# Optional - Sei Network Configuration
NEXT_PUBLIC_SEI_RPC_URL=https://evm-rpc.sei-apis.com
NEXT_PUBLIC_CHAIN_ID=1329

# Development
NODE_ENV=development 